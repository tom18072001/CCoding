{
  "server": { "host": "127.0.0.1", "port": 7420 },
  "dataDir": "data",
  "workspacesDir": "workspaces",
  "agentsDir": "agents",
  "departmentsDir": "departments",

  "runtime": {
    "default": "auto",
    "order": ["claude-cli", "anthropic-api", "codex-cli", "kimi-cli", "ollama", "mock"],
    "quotaCooldownMs": 1800000,
    "maxFailover": 6,
    "rateBackoffMs": 1200000
  },
  "runner": "auto",
  "maxConcurrentTasks": 2,

  "defaults": {
    "discussionRounds": 1,
    "review": true,
    "maxParallel": 3,
    "maxRevisions": 1,
    "budgetTokens": 1500000,
    "budgetMode": "complete",
    "subtaskBudgetTokens": 0,
    "timeoutMs": 1800000
  },

  "phases": {
    "models": { "route": "haiku", "discuss": "haiku" },
    "maxTokens": { "route": 800, "plan": 8000, "discuss": 700, "finalize": 8000, "execute": 32000, "review": 6000, "revise": 32000, "synthesize": 10000 },
    "toolTurns": { "plan": 8, "finalize": 4, "execute": 40, "review": 10, "revise": 16, "synthesize": 4 },
    "toolInputBudget": { "plan": 100000, "finalize": 50000, "execute": 800000, "review": 200000, "revise": 300000, "synthesize": 60000 },
    "maxContinuations": 2
  },

  "tools": {
    "defaultAccess": "write",
    "projectAccess": "exec",
    "commandTimeoutSec": 600,
    "maxOutputChars": 12000,
    "maxReadChars": 30000,
    "denyCommands": [],
    "worktreeCopy": [".env", ".env.local", ".env.development", ".env.development.local", ".env.test", ".env.test.local"],
    "web": true,
    "serializeWriters": true
  },

  "estimate": {
    "base": 150000,
    "perReview": 120000,
    "perSubtask": { "none": 60000, "read": 120000, "write": 200000, "exec": 300000 },
    "web": 100000,
    "warnRatio": 1.2,
    "historyDays": 30,
    "minSamples": 2
  },

  "herdr": {
    "session": "ccoding",
    "workspaceLabel": "CCoding Office",
    "agentPanes": true,
    "closeAgentPanes": false,
    "notify": true,
    "services": []
  },

  "runtimes": {
    "claude-cli": { "command": "claude", "permissionMode": "acceptEdits", "extraArgs": [] },
    "codex-cli": { "command": "codex", "sandbox": "workspace-write", "extraArgs": [] },
    "kimi-cli": { "command": "kimi", "extraArgs": [] },
    "anthropic-api": { "baseUrl": "https://api.anthropic.com", "apiKeyEnv": "ANTHROPIC_API_KEY", "maxTokens": 8000 },
    "openai-api": { "disabled": true, "baseUrl": "", "apiKeyEnv": "OPENAI_API_KEY", "maxTokens": 8000, "local": false, "defaultModel": "" },
    "bifrost": {
      "type": "openai-api",
      "label": "Bifrost gateway",
      "disabled": true,
      "baseUrl": "http://localhost:8080/v1",
      "apiKeyEnv": "BIFROST_API_KEY",
      "tags": "bifrost",
      "virtualKeyHeader": "x-bf-vk",
      "virtualKeys": { "dev": "env:BIFROST_VK_DEV", "research": "env:BIFROST_VK_RESEARCH", "office": "env:BIFROST_VK_OFFICE" },
      "maxTokens": 8000,
      "local": false
    },
    "ollama": { "type": "openai-api", "label": "Ollama (cục bộ)", "baseUrl": "http://localhost:11434/v1", "tags": "none", "maxTokens": 8000, "local": true, "supportsTools": false },
    "mock": { "minDelayMs": 500, "maxDelayMs": 1600 }
  },

  "models": {
    "anthropic-api": { "opus": "claude-opus-5-5", "sonnet": "claude-sonnet-5-5", "haiku": "claude-haiku-5-5" },
    "openai-api": {},
    "bifrost": {},
    "ollama": {},
    "codex-cli": {},
    "kimi-cli": {},
    "claude-cli": {}
  },

  "pricing": {},

  "dataProtection": {
    "defaultClassification": "internal",
    "allowedRuntimes": {
      "public": ["*"],
      "internal": ["*"],
      "confidential": ["local"],
      "restricted": ["local"]
    },
    "redactSecrets": true,
    "redactPii": true,
    "logPrompts": true,
    "hashChain": true,
    "retentionDays": 400
  }
}
