{
  "//": "Sao chép thành ccoding.local.json (đã .gitignore) rồi chỉnh. Chỉ cần ghi những khóa muốn đổi.",
  "runtime": {
    "default": "auto",
    "order": [
      "bifrost",
      "openai-api",
      "kimi-cli",
      "ollama",
      "mock"
    ]
  },
  "runtimes": {
    "bifrost": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "requireEnv": [
        "NINEROUTER_API_KEY"
      ],
      "virtualKeys": {
        "dev": "env:BIFROST_VK_DEV",
        "research": "env:BIFROST_VK_RESEARCH",
        "office": "env:BIFROST_VK_OFFICE"
      }
    },
    "openai-api": {
      "label": "9router (trực tiếp)",
      "baseUrl": "http://127.0.0.1:20128/v1",
      "apiKeyEnv": "NINEROUTER_API_KEY",
      "requireEnv": [
        "NINEROUTER_API_KEY"
      ]
    },
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434/v1",
      "local": true
    }
  },
  "models": {
    "bifrost": {
      "opus": "ninerouter/cc/claude-opus-5-5",
      "sonnet": "ninerouter/cc/claude-sonnet-5-5",
      "haiku": "ninerouter/cc/claude-haiku-4-5-20251001"
    },
    "openai-api": {
      "opus": "cc/claude-opus-5-5",
      "sonnet": "cc/claude-sonnet-5-5",
      "haiku": "cc/claude-haiku-4-5-20251001"
    },
    "ollama": {
      "opus": "qwen3:8b",
      "sonnet": "qwen3:8b",
      "haiku": "qwen3:4b"
    }
  },
  "herdr": {
    "services": [
      {
        "label": "bifrost",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\bifrost.ps1"
      }
    ]
  },
  "dataProtection": {
    "allowedRuntimes": {
      "public": [
        "*"
      ],
      "internal": [
        "*"
      ],
      "confidential": [
        "local"
      ],
      "restricted": [
        "local"
      ]
    }
  }
}
