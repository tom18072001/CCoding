{
  "//": "Sao chép thành ccoding.local.json (đã .gitignore) rồi chỉnh. Chỉ cần ghi những khóa muốn đổi. Model có thể là chuỗi hoặc mảng (chuỗi dự phòng theo thứ tự; mục có dailyTokenLimit = 'mốc miễn phí' — vượt thì tự chuyển sang mục kế tiếp).",
  "runtime": {
    "default": "auto",
    "order": [
      "bifrost",
      "openai-api",
      "kimi-cli",
      "ollama"
    ],
    "quotaCooldownMs": 1800000,
    "maxFailover": 6
  },
  "runtimes": {
    "bifrost": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "requireEnv": [
        "NINEROUTER_API_KEY"
      ],
      "virtualKeys": {
        "dev": "env:BIFROST_VK_DEV",
        "research": "env:BIFROST_VK_RESEARCH",
        "office": "env:BIFROST_VK_OFFICE"
      },
      "promptStyle": "combined",
      "label": "Bifrost → 9router (Claude Max + Codex)"
    },
    "openai-api": {
      "label": "9router (trực tiếp)",
      "baseUrl": "http://127.0.0.1:20128/v1",
      "apiKeyEnv": "NINEROUTER_API_KEY",
      "requireEnv": [
        "NINEROUTER_API_KEY"
      ],
      "promptStyle": "combined"
    },
    "ollama": {
      "baseUrl": "http://127.0.0.1:11434/v1",
      "local": true
    }
  },
  "models": {
    "bifrost": {
      "opus": [
        {
          "model": "ninerouter/cc/claude-opus-5-5",
          "label": "Claude Max · Opus"
        },
        {
          "model": "ninerouter/cx/gpt-6-sol",
          "label": "Codex · GPT-6 Sol"
        }
      ],
      "sonnet": [
        {
          "model": "ninerouter/cc/claude-sonnet-5-5",
          "label": "Claude Max · Sonnet"
        },
        {
          "model": "ninerouter/cx/gpt-6-sol",
          "label": "Codex · GPT-6 Sol"
        }
      ],
      "haiku": [
        {
          "model": "ninerouter/cc/claude-haiku-4-5-20251001",
          "label": "Claude Max · Haiku"
        },
        {
          "model": "ninerouter/cc/claude-sonnet-5-5",
          "label": "Claude Max · Sonnet"
        }
      ]
    },
    "openai-api": {
      "opus": [
        "cc/claude-opus-5-5",
        "cx/gpt-6-sol"
      ],
      "sonnet": [
        "cc/claude-sonnet-5-5",
        "cx/gpt-6-sol"
      ],
      "haiku": [
        "cc/claude-haiku-4-5-20251001",
        "cc/claude-sonnet-5-5"
      ]
    },
    "ollama": {
      "opus": "qwen3:8b",
      "sonnet": "qwen3:8b",
      "haiku": "qwen3:4b"
    }
  },
  "herdr": {
    "services": [
      {
        "label": "bifrost",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\bifrost.ps1"
      }
    ]
  },
  "dataProtection": {
    "allowedRuntimes": {
      "public": [
        "*"
      ],
      "internal": [
        "*"
      ],
      "confidential": [
        "local"
      ],
      "restricted": [
        "local"
      ]
    }
  },
  "defaults": {
    "budgetTokens": 1500000,
    "budgetMode": "complete"
  }
}
