{
  "name": "ccoding",
  "version": "0.1.0",
  "description": "CCoding Office — văn phòng AI đa tác tử: điều phối sub-agent theo phòng ban, tự thảo luận, log theo từng vị trí, đếm token in/out, chạy nền bằng herdr.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "ccoding": "bin/ccoding.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node dist/cli.js serve",
    "serve": "node dist/cli.js serve",
    "dev": "tsx watch src/cli.ts serve",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test --test-force-exit --test-timeout=300000 --test-reporter=spec \"test/**/*.test.ts\"",
    "pretest:bench": "npm run build",
    "test:bench": "node --test --test-force-exit --test-timeout=300000 \"bench/vs-claude/test/*.test.mjs\"",
    "test:research": "node --test --test-timeout=300000 --test-force-exit \"docs/research/**/*.test.mjs\" \"bench/vs-claude/harness/*.test.mjs\"",
    "herdr:up": "node dist/cli.js herdr up",
    "doctor": "node dist/cli.js doctor",
    "demo": "node dist/cli.js task \"Thiết kế API quản lý hồ sơ nhân sự bằng Node.js/TypeScript, có phân quyền và log kiểm toán\" --mode auto --runtime mock --wait",
    "lint": "node scripts/lint/run.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:bench && npm run test:research"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
