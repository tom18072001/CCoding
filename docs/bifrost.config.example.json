{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "enable_logging": true,
    "disable_content_logging": true,
    "enforce_auth_on_inference": true,
    "log_retention_days": 400
  },
  "providers": {
    "ninerouter": {
      "keys": [
        {
          "name": "ninerouter-key",
          "value": "env.NINEROUTER_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:20128",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 900,
        "stream_idle_timeout_in_seconds": 600
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    },
    "ninerouter-claude": {
      "keys": [
        {
          "name": "ninerouter-key",
          "value": "env.NINEROUTER_API_KEY",
          "models": [
            "*"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:20128",
        "allow_private_network": true,
        "default_request_timeout_in_seconds": 900,
        "stream_idle_timeout_in_seconds": 600
      },
      "custom_provider_config": {
        "base_provider_type": "anthropic",
        "allowed_requests": {
          "list_models": true,
          "chat_completion": true,
          "chat_completion_stream": true
        }
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-ccoding-dev",
        "name": "CCoding - Phong Phat trien",
        "description": "Key ảo của Phòng Phát triển Dự án (CCoding)",
        "value": "env.BIFROST_VK_DEV",
        "metadata": {
          "app": "ccoding",
          "department": "dev"
        },
        "provider_configs": [
          {
            "provider": "ninerouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          },
          {
            "provider": "ninerouter-claude",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          }
        ]
      },
      {
        "id": "vk-ccoding-research",
        "name": "CCoding - Phong Nghien cuu",
        "description": "Key ảo của Phòng Nghiên cứu (CCoding)",
        "value": "env.BIFROST_VK_RESEARCH",
        "metadata": {
          "app": "ccoding",
          "department": "research"
        },
        "provider_configs": [
          {
            "provider": "ninerouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          },
          {
            "provider": "ninerouter-claude",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          }
        ]
      },
      {
        "id": "vk-ccoding-office",
        "name": "CCoding - Dieu phoi",
        "description": "Key ảo của Điều phối viên (CCoding)",
        "value": "env.BIFROST_VK_OFFICE",
        "metadata": {
          "app": "ccoding",
          "department": "office"
        },
        "provider_configs": [
          {
            "provider": "ninerouter",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          },
          {
            "provider": "ninerouter-claude",
            "allowed_models": [
              "*"
            ],
            "key_ids": [
              "*"
            ]
          }
        ]
      }
    ]
  }
}
